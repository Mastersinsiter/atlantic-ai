  <!-- ╒╒╒╒╒╒╒ VIDEO PREVIEW CONFIRM MODAL ╒╒╒╒╒╒╒ -->
  <div id="previewModal" style="
  position:fixed;inset:0;z-index:500;
  display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.75);backdrop-filter:blur(12px);
  opacity:0;pointer-events:none;transition:opacity .35s cubic-bezier(.16,1,.3,1)
">
    <div id="previewBox" style="
    width:min(560px,94vw);background:rgba(13,13,22,.97);
    border:1px solid rgba(185,255,102,.25);border-radius:20px;
    padding:24px;position:relative;
    transform:translateY(24px);transition:transform .35s cubic-bezier(.16,1,.3,1)
  ">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
        <span style="font-family:var(--fd);font-size:16px;color:var(--fg)">Confirm Video</span>
        <button onclick="closePreviewModal()" style="
        background:var(--surf);border:1px solid var(--bdr);border-radius:8px;
        padding:6px 12px;color:var(--fgm);cursor:pointer;font-size:13px
      ">✕ Cancel</button>
      </div>
      <!-- YouTube embed OR local file name -->
      <div id="previewContent"
        style="width:100%;border-radius:12px;overflow:hidden;background:#000;min-height:200px;display:flex;align-items:center;justify-content:center">
      </div>
      <div id="previewTitle"
        style="margin-top:14px;font-family:var(--fm);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--fgm)">
      </div>
      <div id="previewClipInfo" style="margin-top:6px;font-size:13px;color:var(--fg);font-weight:500"></div>
      <div style="display:flex;gap:10px;margin-top:18px">
        <button onclick="closePreviewModal()" style="
        flex:1;padding:14px;border-radius:12px;border:1px solid var(--bdr);
        background:var(--surf);color:var(--fg);font-family:var(--fb);
        font-size:14px;cursor:pointer;transition:all .2s
      ">← Change URL</button>
        <button id="previewFullVideoBtn" onclick="confirmAndProcess(true)" style="
        flex:1;padding:14px;border-radius:12px;border:none;
        background:var(--surf);color:var(--text);font-family:var(--fd);font-size:14px;
        font-weight:600;cursor:pointer;transition:all .2s; border:1px solid rgba(255,255,255,0.1);
      ">ðŸŽ¥ Full Video</button>
        <button id="previewConfirmBtn" onclick="confirmAndProcess(false)" style="
        flex:2;padding:14px;border-radius:12px;border:none;
        background:linear-gradient(135deg,#B9FF66,#7FBF3D);
        color:#fff;font-family:var(--fd);font-size:15px;
        font-weight:700;cursor:pointer;transition:all .2s;
        box-shadow:0 6px 24px rgba(185,255,102,.35)
      ">🔨 Make Clips</button>
      </div>
    </div>
  </div>

  <!-- Creator Profile Panel -->
  <div class="profile-overlay" id="profileOverlay" onclick="if(event.target===this)toggleProfilePanel()"></div>
  <div class="profile-panel" id="profilePanel">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
      <h2 style="font-size:1.2rem;font-weight:700;font-family:var(--fd)">⚙️ Creator Profile</h2>
      <button onclick="toggleProfilePanel()"
        style="border-radius:50%;width:32px;height:32px;padding:0;background:var(--surf);border:1px solid var(--bdr);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center">✕</button>
    </div>

    <div class="pp-section">
      <div class="pill-label">Content Type</div>
      <div class="pill-row" id="ppContentType">
        <button class="clip-pill active" onclick="ppPick('ppContentType','gaming',this)">Gaming</button>
        <button class="clip-pill" onclick="ppPick('ppContentType','cooking',this)">Cooking</button>
        <button class="clip-pill" onclick="ppPick('ppContentType','vlog',this)">Vlog</button>
        <button class="clip-pill" onclick="ppPick('ppContentType','education',this)">Education</button>
        <button class="clip-pill" onclick="ppPick('ppContentType','comedy',this)">Comedy</button>
        <button class="clip-pill" onclick="ppPick('ppContentType','other',this)">Other</button>
      </div>
    </div>

    <div class="pp-section">
      <div class="pill-label">Audience Age</div>
      <div class="pill-row" id="ppAudienceAge">
        <button class="clip-pill active" onclick="ppPick('ppAudienceAge','13-18',this)">13-18</button>
        <button class="clip-pill" onclick="ppPick('ppAudienceAge','18-25',this)">18-25</button>
        <button class="clip-pill" onclick="ppPick('ppAudienceAge','25-35',this)">25-35</button>
        <button class="clip-pill" onclick="ppPick('ppAudienceAge','35+',this)">35+</button>
      </div>
    </div>

    <div class="pp-section">
      <div class="pill-label">Style</div>
      <div class="pill-row" id="ppStyle">
        <button class="clip-pill active" onclick="ppPick('ppStyle','energetic',this)">Energetic</button>
        <button class="clip-pill" onclick="ppPick('ppStyle','chill',this)">Chill</button>
        <button class="clip-pill" onclick="ppPick('ppStyle','professional',this)">Professional</button>
        <button class="clip-pill" onclick="ppPick('ppStyle','funny',this)">Funny</button>
        <button class="clip-pill" onclick="ppPick('ppStyle','dramatic',this)">Dramatic</button>
      </div>
    </div>

    <div class="pp-section">
      <div class="pill-label">Clip Style</div>
      <textarea class="pp-textarea" id="ppClipStyle" rows="2"
        placeholder="How should clips start and feel?">start with action not buildup</textarea>
    </div>

    <div class="pp-section">
      <div class="pill-label">Avoid</div>
      <textarea class="pp-textarea" id="ppAvoid" rows="2"
        placeholder="What should be avoided?">slow sections, long talking, boring intros</textarea>
    </div>

    <div class="pp-section" style="border-top:1px solid var(--bdr);padding-top:1rem;margin-top:0.5rem">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
        <div class="pill-label" style="margin:0">Watermark</div>
        <label class="toggle-switch"><input type="checkbox" id="wmEnabled" onchange="wmToggle()"><span
            class="toggle-slider"></span></label>
      </div>
      <div id="wmSettings" style="display:none">
        <div class="pill-row" style="margin-bottom:0.75rem" id="wmType">
          <button class="clip-pill active" onclick="ppPick('wmType','text',this);wmTypeChange('text')">Text</button>
          <button class="clip-pill" onclick="ppPick('wmType','image',this);wmTypeChange('image')">Image</button>
        </div>
        <div id="wmTextInput"><input class="pp-textarea" id="wmText" style="padding:8px 12px;width:100%"
            placeholder="@yourchannel" value="@yourchannel" /></div>
        <div id="wmImageInput" style="display:none"><input type="file" id="wmImageFile" accept="image/png"
            style="font-size:0.8rem;color:var(--fgm)" />
          <div style="font-size:0.65rem;color:var(--fgm);margin-top:4px">PNG with transparency recommended</div>
        </div>
        <div class="pill-label" style="margin-top:0.75rem">Position</div>
        <div class="wm-grid" id="wmPosGrid"></div>
        <div class="pill-label" style="margin-top:0.75rem">Opacity: <span id="wmOpacityVal">80%</span></div>
        <input type="range" id="wmOpacity" min="10" max="100" value="80" class="pp-range"
          oninput="document.getElementById('wmOpacityVal').textContent=this.value+'%'" />
        <div class="pill-label" style="margin-top:0.75rem">Size (px)</div>
        <input type="number" id="wmSize" min="10" max="150" value="36" class="pp-textarea" style="padding:8px 12px" />
      </div>
    </div>

    <button class="btn"
      style="width:100%;padding:14px;margin-top:1.5rem;font-size:0.95rem;background:var(--pri);color:white;border:none;border-radius:10px;cursor:pointer"
      onclick="saveProfile()">ðŸ’¾ Save Profile</button>
  </div>

  <!-- ╒╒╒╒╒╒╒ SCRIPTS ╒╒╒╒╒╒╒ -->
  <script src="app.js?v=2"></script>
  <script src="cropEditor.js?v=3"></script>
  <script src="editor.js?v=1"></script>

  <!-- ╒╒╒╒╒╒╒ NEW UI ENGINE ╒╒╒╒╒╒╒ -->
  <script>
    (function AtlanticAIUI() {
      'use strict';

      // ── Stars ──
      const sc = document.getElementById('stars');
      for (let i = 0; i < 90; i++) {
        const s = document.createElement('div'); s.className = 'star';
        const sz = Math.random() * 2 + 0.5;
        s.style.cssText = `left:${Math.random() * 100}%;top:${Math.random() * 100}%;width:${sz}px;height:${sz}px;--lo:${(Math.random() * .15 + .03).toFixed(2)};--hi:${(Math.random() * .5 + .25).toFixed(2)};--dur:${(Math.random() * 4 + 2).toFixed(1)}s;--delay:${(Math.random() * 6).toFixed(1)}s`;
        sc.appendChild(s);
      }

      // ── Waveform Bars ──
      const wh = [18, 24, 35, 52, 68, 74, 80, 90, 75, 62, 80, 88, 76, 58, 45, 60, 78, 90, 85, 70, 55, 42, 65, 80, 88, 76, 60, 72, 85, 90, 78, 60, 50, 68, 75, 58, 40, 30, 22, 16];
      const wc = document.getElementById('wbs');
      if (wc) wh.forEach((v, i) => { const b = document.createElement('div'); b.className = 'wb' + (i % 4 === 0 ? ' a' : ''); b.style.height = v + 'px'; b.style.animationDelay = (i * 38) + 'ms'; wc.appendChild(b); });

      // ── Kill Feed ──
      const kfItems = [
        { n: 'xQc', a: 'clipped a 1v5 ace', v: '4.2M views' },
        { n: 'shroud', a: 'went viral', v: '2.8M in 6hrs' },
        { n: 'Pokimane', a: 'exported 3 clips', v: 'Reels + Shorts + TikTok' },
        { n: 'TimTheTatman', a: 'found 12 highlights', v: 'from a 4hr VOD' },
        { n: 'Ninja', a: 'auto-captioned & posted', v: '8 clips in 45s' },
        { n: 'HasanAbi', a: 'clipped a comeback win', v: '3.1M impressions' },
        { n: 'Valkyrae', a: 'found a rage clip', v: 'went viral on X' },
        { n: 'Sykkuno', a: 'exported a funny moment', v: '1.9M TikTok views' },
        { n: 'Ludwig', a: 'detected 23 clips', v: 'from 8hr subathon' },
      ];
      const kfc = document.getElementById('kft');
      if (kfc) [...kfItems, ...kfItems].forEach(x => {
        const el = document.createElement('div'); el.className = 'kfi';
        el.innerHTML = `<span class="kfn">[${x.n}]</span><span class="kfa">${x.a}</span><span class="kfd"></span><span class="kfv">${x.v}</span>`;
        kfc.appendChild(el);
      });

      // ── Counter Animation ──
      let cFired = false;
      const cEl = document.getElementById('cfCtr'), fEl = document.getElementById('cfFil');
      if (cEl) new IntersectionObserver(e => {
        if (e[0].isIntersecting && !cFired) {
          cFired = true; const st = performance.now();
          (function step(now) {
            const t = Math.min((now - st) / 1800, 1), ea = 1 - Math.pow(1 - t, 3);
            cEl.textContent = Math.floor(ea * 847); if (fEl) fEl.style.width = (ea * 85) + '%';
            t < 1 ? requestAnimationFrame(step) : cEl.textContent = 847;
          })(st);
        }
      }, { threshold: 0.3 }).observe(cEl);

      // ── Scroll Reveal ──
      document.querySelectorAll('.rv').forEach(el => {
        new IntersectionObserver(e => { if (e[0].isIntersecting) el.classList.add('in'); }, { threshold: 0.1 }).observe(el);
      });

      // ── Drop Zone ──
      const dz = document.getElementById('input-file');
      if (dz) {
        dz.addEventListener('click', () => document.getElementById('dashFileInput').click());
        dz.addEventListener('dragover', e => { e.preventDefault(); dz.style.borderColor = 'var(--pri)'; dz.style.background = 'var(--surfh)'; });
        dz.addEventListener('dragleave', () => { dz.style.borderColor = ''; dz.style.background = ''; });
        dz.addEventListener('drop', e => {
          e.preventDefault(); dz.style.borderColor = ''; dz.style.background = '';
          const f = e.dataTransfer.files[0];
          if (f && f.type.startsWith('video/')) {
            window.selectedFile = f;
            document.getElementById('dashFileName').textContent = f.name + ' (' + (f.size / 1048576).toFixed(1) + ' MB)';
          }
        });
      }
    })();

    // ╒╒╒╒╒╒╒ OVERRIDE app.js functions for new UI ╒╒╒╒╒╒╒

    // Override switchTab to work with new class names
    window.switchTab = function (mode) {
      const urlWrap = document.getElementById('input-url');
      const fileWrap = document.getElementById('input-file');
      const tabUrl = document.getElementById('tab-url');
      const tabFile = document.getElementById('tab-file');

      if (mode === 'url') {
        urlWrap.style.display = 'block';
        fileWrap.classList.remove('show');
        tabUrl.classList.add('on');
        tabFile.classList.remove('on');
      } else {
        urlWrap.style.display = 'none';
        fileWrap.classList.add('show');
        tabUrl.classList.remove('on');
        tabFile.classList.add('on');
      }
    };

    // Override handleSubmit to use preview modal flow
    window.handleSubmit = function () {
      const isFile = document.getElementById('tab-file').classList.contains('on');
      if (isFile) {
        showFilePreview();
      } else {
        showUrlPreview();
      }
    };

    // Forge overlay stages
    const _forgeStages = [
      { s: '🔨 FORGING YOUR CLIP...', b: 'The AI is scanning every moment.' },
      { s: 'ðŸ” DETECTING HIGHLIGHTS...', b: 'Finding every kill feed, hype moment, and comeback.' },
      { s: '✂️ CUTTING THE CLIPS...', b: 'Shaping your raw footage into viral content.' },
      { s: '✨ ALMOST READY...', b: 'Your clips are nearly done.' },
    ];
    let _forgeStageIdx = 0, _forgeTimer = null;

    function _forgeNext() {
      if (_forgeStageIdx < _forgeStages.length) {
        const st = _forgeStages[_forgeStageIdx];
        const statusEl = document.getElementById('forgeStatus');
        const subEl = document.getElementById('forgeSub');
        if (statusEl) statusEl.textContent = st.s;
        if (subEl) subEl.textContent = st.b;
        _forgeStageIdx++;
      }
    }

    // Override showProgress to use forge overlay
    window.showProgress = function () {
      document.getElementById('input-section').style.display = 'none';
      document.getElementById('results-section').classList.remove('active');
      const ov = document.getElementById('forgeOverlay');
      ov.classList.add('active');
      const btn = document.getElementById('dashProcessBtn');
      btn.classList.add('ld');
      _forgeStageIdx = 0;
      _forgeNext();
      _forgeTimer = setInterval(_forgeNext, 2500);
    };

    // Override showResults to use new results UI
    window.showResults = function (job) {
      // Hide forge overlay
      const ov = document.getElementById('forgeOverlay');
      ov.classList.remove('active');
      clearInterval(_forgeTimer);
      const btn = document.getElementById('dashProcessBtn');
      btn.classList.remove('ld');
      document.getElementById('forgePct').textContent = '';

      // Show results
      document.getElementById('results-section').classList.add('active');
      document.getElementById('clipCount').textContent = (job.clips || []).length;

      const grid = document.getElementById('clipsGrid');
      grid.innerHTML = (job.clips || []).map((c, i) => {
        const cid = c.clip_id || c.id || ('clip_' + i);
        c.jobReframeMode = job.options?.reframeMode || 'blur-pad';
        clipDataMap[cid] = c;
        const title = c.title || 'Clip ' + (i + 1);
        const safeTitle = title.replace(/'/g, "&apos;");
        const clipDataJSON = encodeURIComponent(JSON.stringify({ title: c.title, score: c.score, start: c.start, end: c.end }));
        return `
    <div class="cf-clip-card">
      <video src="${API}${c.url}" controls preload="metadata"></video>
      <h3>${title}</h3>
      <p class="cf-score">Score: ${c.score || 0}</p>
      <div class="cf-clip-actions">
        <button class="btn btn-pri" onclick="openEditor('${cid}', '${c.url}', '${safeTitle}')">Edit / Preview</button>
        <button class="btn-reframe" onclick="openCropEditor('${job.id}', ${i}, '${job.videoUrl || c.url}', JSON.parse(decodeURIComponent('${clipDataJSON}')))">✏️ Edit Framing</button>
        <a class="btn btn-out" href="${API}${c.url}" download>Download</a>
      </div>
    </div>`;
      }).join('');
    };

    // Override resetToInput
    window.resetToInput = function () {
      document.getElementById('input-section').style.display = '';
      document.getElementById('results-section').classList.remove('active');
      const ov = document.getElementById('forgeOverlay');
      ov.classList.remove('active');
      clearInterval(_forgeTimer);
      const btn = document.getElementById('dashProcessBtn');
      btn.classList.remove('ld');
      if (typeof setWorldState === 'function') setWorldState('idle');
    };

    // Override pollJob to update forge overlay with progress %
    const _origPollJob = window.pollJob;
    window.pollJob = async function (id) {
      try {
        const res = await fetch(`${API}/api/status/${id}`);
        const job = await res.json();

        if (typeof setWorldState === 'function') {
          if (job.status === 'processing') {
            if (job.progress < 20) setWorldState('uploading');
            else if (job.progress < 50) setWorldState('clipping');
            else setWorldState('downloading');
          } else if (job.status === 'queued') setWorldState('queued');
        }

        // Update forge overlay with progress
        const pctEl = document.getElementById('forgePct');
        if (pctEl && job.progress) pctEl.textContent = (job.progress || 0) + '%';

        const ll = (job.logs || []).length ? job.logs[job.logs.length - 1].msg : '';
        const subEl = document.getElementById('forgeSub');
        if (subEl && ll) subEl.textContent = ll.slice(0, 80) || 'Processing…';

        if (job.status === 'completed' || job.status === 'failed') {
          clearInterval(pollingIntervals[id]);
          delete pollingIntervals[id];
          if (job.status === 'completed') {
            toast('✅ ' + job.clips.length + ' clips ready!', 'success');
            if (typeof setWorldState === 'function') setWorldState('complete');
            if (id === activeJobId) showResults(job);
          } else {
            toast('❌ ' + (job.error || 'Failed'), 'error');
            if (typeof setWorldState === 'function') setWorldState('error');
            if (id === activeJobId) resetToInput();
          }
        }
      } catch (e) { }
    };

    // Override loadJobs for new style
    window.loadJobs = async function () {
      try {
        const res = await fetch(`${API}/api/jobs`);
        const jobs = await res.json();
        const list = document.getElementById('jobsList');
        list.innerHTML = '';
        if (!jobs.length) {
          list.innerHTML = '<div class="recemp"><p class="recei">ðŸŽ®</p><p>No clips extracted yet.</p><p style="margin-top:6px;font-size:12px;font-family:var(--fm)">Paste a YouTube URL above to get started.</p></div>';
          return;
        }
        jobs.forEach(job => {
          const card = document.createElement('div');
          card.className = 'job-card';
          card.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center">
        <strong>${job.videoTitle || job.url || 'Upload'}</strong>
        <span style="color:var(--pril);font-family:var(--fm);font-size:12px">${job.status}</span>
      </div>`;
          if (job.status === 'completed') card.onclick = () => showResults(job);
          list.appendChild(card);
          if (job.status === 'processing' || job.status === 'queued') startPolling(job.id);
        });
      } catch { }
    };

    // Re-run loadJobs on DOMContentLoaded (app.js runs it too, but our override needs to take effect)
    document.addEventListener('DOMContentLoaded', () => { setTimeout(loadJobs, 200); });
  </script>

  <!-- ╒╒╒╒╒╒╒ CROP / REFRAME EDITOR OVERLAY ╒╒╒╒╒╒╒ -->
  <div class="crop-editor-overlay" id="cropEditorOverlay">
    <!-- Header -->
    <div class="crop-editor-header">
      <div class="crop-header-left">
        <button class="crop-back-btn" onclick="closeCropEditor()">← Back</button>
        <div style="display: flex; flex-direction: column; justify-content: center;">
          <span id="cropEditorTitle" style="font-size: 10px; color: var(--text2); opacity: 0.7; margin-bottom: 2px;">Edit Framing</span>
          <span class="crop-header-title" style="font-size: 15px; opacity: 1;"><strong>Position the Crop</strong></span>
          <span style="font-size: 11px; color: var(--text2); opacity: 0.8;">Click or drag to position. Drag edges to resize.</span>
        </div>
      </div>
      <div class="crop-mode-tabs" style="display:flex; align-items:center; gap:4px;">
        <button class="crop-mode-tab active" data-mode="vertical" onclick="setCropMode('vertical')">Vertical</button>
        <button class="crop-mode-tab" data-mode="split" onclick="setCropMode('split')">Split</button>
        <button class="crop-mode-tab" data-mode="trio" onclick="setCropMode('trio')">Trio</button>
        <button class="crop-mode-tab" data-mode="spotlight" onclick="setCropMode('spotlight')">Spotlight</button>
        <button class="crop-mode-tab" data-mode="centered" onclick="setCropMode('centered')">Centered</button>
        <button class="crop-mode-tab" data-mode="horizontal" onclick="setCropMode('horizontal')">Horizontal</button>
        
        <div class="crop-info-trigger" id="cropModeInfoBtn" style="margin-left:8px; cursor:help; color:var(--text2); display:flex; align-items:center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </div>
      </div>
      <div class="crop-header-right">
        <label style="color:#fff; font-size:14px; margin-right:16px; display:flex; align-items:center; gap:8px;">
          <input type="checkbox" id="cropApproveToggle" checked style="width:18px;height:18px;">
          Approve Clip
        </label>
        <button class="crop-export-btn" id="cropExportBtn" onclick="exportJobClips()">⬇ Export Approved</button>
      </div>
    </div>

    <!-- Main: Source video + Preview -->
    <div class="crop-editor-main">
      <!-- Source video panel -->
      <div class="crop-source-panel">
        <div class="crop-source-wrapper">
          <video id="cropSourceVideo" preload="metadata" crossorigin="anonymous" disablepictureinpicture></video>
          <!-- Dark overlay — dims everything outside crop regions -->
          <div class="crop-dark-overlay" id="cropDarkOverlay"></div>
          <!-- Crop regions layer — draggable boxes rendered by JS -->
          <div class="crop-regions-layer" id="cropRegionsLayer"></div>
        </div>
      </div>

      <!-- Preview sidebar -->
      <div class="crop-preview-panel">
        
        <div class="crop-positions-section" style="margin-bottom: 24px; padding: 16px; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
          <div class="crop-positions-title" style="display:flex; justify-content:space-between; margin-bottom:12px;">
            <span style="font-weight:600; font-size:13px;">Crop Positions</span>
            <span style="background:rgba(255,255,255,0.1); padding:2px 6px; border-radius:4px; font-size:11px;">1</span>
          </div>
          <div id="cropPositionsRow" style="display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text2);">
              <div style="width:6px; height:6px; border-radius:50%; background:#A8D8A0;"></div>
              <span id="cropPositionsTimeRange">0:00 - 0:00</span>
              <span id="cropPositionsRatio" style="margin-left:auto; font-size:11px; opacity:0.6;"></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.5; cursor:pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </div>
            <div class="crop-positions-timeline" style="width:100%; height:4px; background:rgba(255,255,255,0.1); border-radius:2px; position:relative;">
              <div class="crop-positions-progress" id="cropPositionsProgress" style="height:100%; background:#A8D8A0; border-radius:2px; width:0%;"></div>
              <div class="crop-positions-playhead" id="cropPositionsPlayhead" style="width:2px; height:8px; background:#fff; position:absolute; top:-2px; left:0%;"></div>
            </div>
          </div>
        </div>

        <div class="crop-preview-title">Preview (9:16)</div>
        <div class="crop-preview-canvas-wrap">
          <canvas id="cropPreviewCanvas"></canvas>
          <div class="crop-preview-watermark">Atlantic AI</div>
        </div>
      </div>
    </div>

    <!-- Playback controls & Timeline -->
    <div class="crop-playback-controls" style="flex-direction:column; padding: 10px 24px;">
      <!-- Timeline row -->
      <div
        style="width:100%; position:relative; height:40px; background:rgba(255,255,255,0.05); border-radius:8px; margin-bottom:10px;"
        id="cropClipsTimeline">
        <!-- Clip blocks will be injected here -->
        <div id="cropTimelinePlayhead"
          style="position:absolute; left:0; top:0; bottom:0; width:2px; background:var(--pril); z-index:10; pointer-events:none;">
        </div>
      </div>

      <!-- Controls row -->
      <div style="display:flex; width:100%; align-items:center; gap:16px;">
        <button class="crop-step-btn" id="cropUndoBtn" title="Undo" style="display:flex; align-items:center; justify-content:center; background:transparent; border:none; color:var(--text2); cursor:pointer;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
        </button>
        <button class="crop-step-btn" id="cropRedoBtn" title="Redo" style="display:flex; align-items:center; justify-content:center; background:transparent; border:none; color:var(--text2); cursor:pointer;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"></path><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"></path></svg>
        </button>
        <button class="crop-step-btn" id="cropStepBack" title="Step back">⏮</button>
        <button class="crop-play-btn" id="cropPlayBtn" title="Play/Pause">▶</button>
        <button class="crop-step-btn" id="cropStepFwd" title="Step forward">⏭</button>
        <input type="range" class="crop-scrubber" id="cropScrubber" min="0" max="100" step="0.1" value="0"
          style="flex:1;">
        <span class="crop-time-display" id="cropTimeDisplay">00:00 / 00:00</span>
        <button class="crop-speed-btn" id="cropSpeedBtn" title="Playback speed">1x</button>
      </div>
    </div>
  </div>

  <!-- ╒╒╒╒╒╒╒ NEW MODULAR EDITOR OVERLAY ╒╒╒╒╒╒╒ -->
  <div class="crop-editor-overlay" id="newEditorOverlay"
    style="z-index: 1000; flex-direction: column; opacity: 0; pointer-events: none;">
    <!-- Header -->
    <div class="crop-editor-header" style="justify-content: space-between;">
      <div class="crop-header-left">
        <button class="crop-back-btn" onclick="window.currentEditor?.close()">← Back</button>
        <span class="crop-header-title">Full Video Editor</span>
      </div>

      <!-- Center Tabs -->
      <div class="crop-mode-tabs" style="gap: 16px;">
        <button class="crop-mode-tab editor-tab active" data-tab="layout">Layout & Framing</button>
        <button class="crop-mode-tab editor-tab" data-tab="captions">Captions & Style</button>
        <button class="crop-mode-tab editor-tab" data-tab="export">Export Settings</button>
      </div>

      <div class="crop-header-right">
        <button class="crop-export-btn" onclick="window.currentEditor?.saveAndExport()">⬇ Export Project</button>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="crop-editor-main" style="display: flex; flex: 1; overflow: hidden; background: #0A0A0A;">

      <!-- Sidebar -->
      <div id="editorSidebarPane"
        style="width: 300px; padding: 24px; background: #111; border-right: 1px solid var(--bdr); overflow-y: auto;">
        <!-- Populated dynamically by editor.js -->
      </div>

      <!-- Preview Area -->
      <div
        style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; position: relative;">
        <video id="newEditorVideo" style="display:none;" preload="auto" crossorigin="anonymous"></video>
        <canvas id="newEditorPreview" width="1080" height="1920"
          style="max-height: 100%; object-fit: contain; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.5);"></canvas>
      </div>

    </div>

    <!-- Timeline Strip -->
    <div class="crop-playback-controls"
      style="flex-direction:column; padding: 10px 24px; background: #111; border-top: 1px solid var(--bdr);">
      <!-- Timeline row -->
      <div id="editorTimelineStrip"
        style="width:100%; position:relative; height:40px; background:rgba(255,255,255,0.05); border-radius:8px; margin-bottom:10px; overflow: hidden;">
        <!-- Playhead & Segments injected by JS -->
      </div>

      <!-- Controls row -->
      <div style="display:flex; width:100%; align-items:center; gap:16px;">
        <button class="crop-step-btn" onclick="window.currentEditor?.video.currentTime -= 0.1"
          title="Step back">⏮</button>
        <button class="crop-play-btn" onclick="const v = window.currentEditor?.video; v.paused ? v.play() : v.pause()"
          title="Play/Pause">▶</button>
        <button class="crop-step-btn" onclick="window.currentEditor?.video.currentTime += 0.1"
          title="Step forward">⏭</button>
      </div>
    </div>
  </div>

  <!-- ╒╒╒╒╒╒╒ EDITOR MODAL (preserved from original) ╒╒╒╒╒╒╒ -->
  <div class="editor-modal" id="editorModal">
    <div class="editor-header">
      <h2 style="font-family: var(--font-display);">Edit Clip: <span id="editorClipTitle"></span></h2>
      <div>
        <button class="btn btn-outline" onclick="closeEditor()">Cancel</button>
        <button class="btn" onclick="renderAndExport()">Render & Export</button>
      </div>
    </div>
    <div class="editor-body">
      <div class="editor-col col-left">
        <!-- Layout Picker -->
        <div class="layout-section">
          <h4>Layout Mode</h4>
          <div class="layout-picker" id="layoutPicker">
            <button class="layout-pill active" data-layout="blur-pad" onclick="setLayout('blur-pad', this)">
              <svg viewBox="0 0 36 48" fill="none">
                <rect x="1" y="1" width="34" height="46" rx="3" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <rect x="3" y="14" width="30" height="20" rx="2" fill="currentColor" opacity="0.3" />
                <rect x="5" y="16" width="26" height="16" rx="1" fill="currentColor" opacity="0.6" />
              </svg>
              <span class="lp-label">Blur Pad</span>
            </button>
            <button class="layout-pill" data-layout="split-screen" onclick="setLayout('split-screen', this)">
              <svg viewBox="0 0 36 48" fill="none">
                <rect x="1" y="1" width="34" height="46" rx="3" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <rect x="3" y="3" width="30" height="20" rx="2" fill="currentColor" opacity="0.5" />
                <line x1="3" y1="24" x2="33" y2="24" stroke="currentColor" stroke-width="0.5" opacity="0.4" />
                <rect x="3" y="25" width="30" height="20" rx="2" fill="currentColor" opacity="0.3" />
              </svg>
              <span class="lp-label">Split</span>
            </button>
            <button class="layout-pill" data-layout="focus-left" onclick="setLayout('focus-left', this)">
              <svg viewBox="0 0 36 48" fill="none">
                <rect x="1" y="1" width="34" height="46" rx="3" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <rect x="2" y="3" width="18" height="42" rx="2" fill="currentColor" opacity="0.5" />
                <rect x="21" y="3" width="14" height="42" rx="2" fill="currentColor" opacity="0.15" />
              </svg>
              <span class="lp-label">Focus L</span>
            </button>
            <button class="layout-pill" data-layout="focus-center" onclick="setLayout('focus-center', this)">
              <svg viewBox="0 0 36 48" fill="none">
                <rect x="1" y="1" width="34" height="46" rx="3" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <rect x="5" y="3" width="26" height="42" rx="2" fill="currentColor" opacity="0.15" />
                <rect x="9" y="3" width="18" height="42" rx="2" fill="currentColor" opacity="0.5" />
              </svg>
              <span class="lp-label">Focus C</span>
            </button>
            <button class="layout-pill" data-layout="focus-right" onclick="setLayout('focus-right', this)">
              <svg viewBox="0 0 36 48" fill="none">
                <rect x="1" y="1" width="34" height="46" rx="3" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <rect x="2" y="3" width="14" height="42" rx="2" fill="currentColor" opacity="0.15" />
                <rect x="16" y="3" width="18" height="42" rx="2" fill="currentColor" opacity="0.5" />
              </svg>
              <span class="lp-label">Focus R</span>
            </button>
          </div>
        </div>

        <!-- Reframe Keyframes -->
        <div class="keyframe-section">
          <h4>
            Reframe Keyframes
            <button class="btn-add-kf" onclick="addReframeKeyframe()">+ Add</button>
          </h4>
          <div class="keyframe-list" id="keyframeList">
            <div class="keyframe-empty">No keyframes — static layout will be used</div>
          </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--bdr); margin-bottom: 1.5rem;">

        <h3 style="margin-bottom: 1rem; color: var(--accent-violet);">Subtitles</h3>
        <div id="subtitlesList" class="subtitles-list"></div>
        <button class="btn btn-outline" style="width: 100%; margin-top: 1rem" onclick="addSubtitle()">+ Add
          Subtitle</button>
      </div>
      <div class="editor-col col-center">
        <div class="video-container">
          <video id="editorVideo" src="" crossorigin="anonymous" disablepictureinpicture></video>
          <div id="videoOverlay" class="video-overlay"></div>
          <div class="video-controls">
            <button id="playPauseBtn" onclick="togglePlay()">Play</button>
            <input type="range" id="videoScrubber" min="0" max="100" value="0" step="0.1">
            <span id="videoTime">00:00 / 00:00</span>
          </div>
        </div>
        <div class="waveform-container"><canvas id="waveformCanvas"></canvas></div>
      </div>
      <div class="editor-col col-right">
        <h3 style="margin-bottom: 1rem; color: var(--accent-blue);">Styles & Watermark</h3>
        <div class="control-group">
          <label>Font</label>
          <div class="font-pills" id="fontPills">
            <button class="font-pill active" data-font="Impact" style="font-family: Impact">Impact</button>
            <button class="font-pill" data-font="Bangers" style="font-family: 'Bangers', sans-serif">Bangers</button>
            <button class="font-pill" data-font="Arial" style="font-family: Arial; font-weight: bold;">Arial
              Bold</button>
            <button class="font-pill" data-font="Space Grotesk" style="font-family: 'Space Grotesk'">Space</button>
            <button class="font-pill" data-font="Oswald" style="font-family: Oswald">Oswald</button>
            <button class="font-pill" data-font="Courier New" style="font-family: 'Courier New'">Courier</button>
          </div>
        </div>
        <div class="control-group">
          <label>Colors</label>
          <div class="color-swatches" id="colorSwatches">
            <button class="color-swatch active" data-color="#ffffff" style="background: #ffffff"></button>
            <button class="color-swatch" data-color="#ffff00" style="background: #ffff00"></button>
            <button class="color-swatch" data-color="#00ff00" style="background: #00ff00"></button>
            <button class="color-swatch" data-color="#ff0000" style="background: #ff0000"></button>
            <button class="color-swatch" data-color="#00ffff" style="background: #00ffff"></button>
            <button class="color-swatch" data-color="#ff00ff" style="background: #ff00ff"></button>
            <button class="color-swatch" data-color="#ffa500" style="background: #ffa500"></button>
            <button class="color-swatch" data-color="#0000ff" style="background: #0000ff"></button>
          </div>
        </div>
        <div class="control-group">
          <label>Effects</label>
          <div class="range-group"><span>Outline</span><input type="range" id="styleOutline" min="0" max="10" value="2">
          </div>
          <div class="range-group"><span>Shadow</span><input type="range" id="styleShadow" min="0" max="20" value="5">
          </div>
          <div class="range-group"><span>Size</span><input type="range" id="styleSize" min="10" max="100" value="48">
          </div>
          <div class="range-group"><span>Position Y</span><input type="range" id="stylePosY" min="0" max="100"
              value="80"></div>
        </div>
        <div class="control-group">
          <label>Animation Type</label>
          <select id="styleAnimation">
            <option value="none">None</option>
            <option value="pop">Pop</option>
            <option value="slide">Slide</option>
            <option value="fade">Fade</option>
          </select>
        </div>
        <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
        <div class="control-group">
          <label>Watermark</label>
          <input type="text" id="watermarkText" placeholder="Enter watermark text..."
            style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); padding: 0.8rem; border-radius: 8px; color: white; margin-bottom: 0.5rem;">
          <div style="display: flex; gap: 1rem;">
            <div class="position-grid" id="watermarkGrid">
              <button class="pos-btn" data-pos="tl"></button>
              <button class="pos-btn" data-pos="tc"></button>
              <button class="pos-btn" data-pos="tr"></button>
              <button class="pos-btn" data-pos="ml"></button>
              <button class="pos-btn" data-pos="mc"></button>
              <button class="pos-btn" data-pos="mr"></button>
              <button class="pos-btn" data-pos="bl"></button>
              <button class="pos-btn" data-pos="bc"></button>
              <button class="pos-btn active" data-pos="br"></button>
            </div>
            <div style="flex: 1;">
              <div class="range-group"><span>Opacity</span><input type="range" id="watermarkOpacity" min="0" max="100"
                  value="50"></div>
              <div class="range-group"><span>Size</span><input type="range" id="watermarkSize" min="10" max="100"
                  value="24"></div>
            </div>
          </div>
        </div>
        <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
        <div class="control-group">
          <label>AI Voiceover Script (ElevenLabs)</label>
          <textarea id="voiceoverText" placeholder="Type a script here for ElevenLabs to read over this clip..."
            style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); padding: 0.8rem; border-radius: 8px; color: white; resize: vertical; min-height: 80px;"></textarea>
        </div>
        <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
        <div class="control-group">
          <label>Meme Reference Templates</label>
          <div class="meme-grid">
            <button class="meme-preset">Pepe</button>
            <button class="meme-preset">Doge</button>
            <button class="meme-preset">Troll</button>
            <button class="meme-preset">Wojak</button>
            <button class="meme-preset">Drake</button>
            <button class="meme-preset">Gigachad</button>
            <button class="meme-preset">Stonks</button>
            <button class="meme-preset">Cat</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Creator Profile JS -->
  <script>
    let currentProfile = {};

    async function loadProfile() {
      try {
        const res = await fetch('/api/profile');
        const data = await res.json();
        currentProfile = data;

        selectPill('ppContentType', data.content_type || 'gaming');
        selectPill('ppAudienceAge', data.audience_age || '13-25');
        selectPill('ppStyle', data.style || 'energetic');
        document.getElementById('ppClipStyle').value = data.clip_style || 'start with action not buildup';
        document.getElementById('ppAvoid').value = data.avoid || 'slow sections, long talking, boring intros';

        const wm = data.watermark || {};
        document.getElementById('wmEnabled').checked = !!wm.enabled;
        document.getElementById('wmText').value = wm.text || '@yourchannel';
        document.getElementById('wmOpacity').value = (wm.opacity !== undefined) ? wm.opacity * 100 : 80;
        document.getElementById('wmOpacityVal').textContent = Math.round((wm.opacity !== undefined) ? wm.opacity * 100 : 80) + '%';
        document.getElementById('wmSize').value = wm.size || 36;

        const isImage = !!wm.image_path;
        selectPill('wmType', isImage ? 'image' : 'text');
        wmTypeChange(isImage ? 'image' : 'text');

        initWatermarkPosGrid(wm.position || 'bottom-right');

        wmToggle();
      } catch (err) {
        console.error('Failed to load profile:', err);
      }
    }

    function selectPill(rowId, val) {
      const row = document.getElementById(rowId);
      if (!row) return;
      const btns = row.getElementsByTagName('button');
      for (const btn of btns) {
        const onclick = btn.getAttribute('onclick') || '';
        const matches = onclick.match(/'([^']+)'/g);
        if (matches && matches.length >= 2) {
          const btnVal = matches[1].replace(/'/g, '');
          if (btnVal === val) {
            for (const b of btns) b.classList.remove('active');
            btn.classList.add('active');
            break;
          }
        }
      }
    }

    function ppPick(rowId, val, btn) {
      const row = document.getElementById(rowId);
      const btns = row.getElementsByTagName('button');
      for (const b of btns) b.classList.remove('active');
      btn.classList.add('active');
    }

    function wmToggle() {
      const enabled = document.getElementById('wmEnabled').checked;
      document.getElementById('wmSettings').style.display = enabled ? 'block' : 'none';
    }

    function wmTypeChange(type) {
      document.getElementById('wmTextInput').style.display = type === 'text' ? 'block' : 'none';
      document.getElementById('wmImageInput').style.display = type === 'image' ? 'block' : 'none';
    }

    const posGridList = [
      'top-left', 'top-center', 'top-right',
      'center-left', 'center', 'center-right',
      'bottom-left', 'bottom-center', 'bottom-right'
    ];

    function initWatermarkPosGrid(activePos) {
      const grid = document.getElementById('wmPosGrid');
      grid.innerHTML = posGridList.map(pos => {
        const isActive = pos === activePos;
        const arrow = getArrow(pos);
        return `<button class="clip-pill ${isActive ? 'active' : ''}" onclick="ppPick('wmPosGrid','${pos}',this)" title="${pos}">${arrow}</button>`;
      }).join('');
    }

    function getArrow(pos) {
      const map = {
        'top-left': '↖', 'top-center': '↑', 'top-right': '↗',
        'center-left': '←', 'center': '•', 'center-right': '→',
        'bottom-left': '↙', 'bottom-center': '↓', 'bottom-right': '↘'
      };
      return map[pos] || '•';
    }

    function toggleProfilePanel() {
      const overlay = document.getElementById('profileOverlay');
      const panel = document.getElementById('profilePanel');
      const isOpen = panel.classList.contains('open');
      if (isOpen) {
        overlay.classList.remove('open');
        panel.classList.remove('open');
      } else {
        loadProfile();
        overlay.classList.add('open');
        panel.classList.add('open');
      }
    }

    async function saveProfile() {
      const contentType = getActivePillVal('ppContentType');
      const audienceAge = getActivePillVal('ppAudienceAge');
      const style = getActivePillVal('ppStyle');
      const clipStyle = document.getElementById('ppClipStyle').value;
      const avoid = document.getElementById('ppAvoid').value;

      const wmEnabled = document.getElementById('wmEnabled').checked;
      const wmType = getActivePillVal('wmType');
      const wmText = document.getElementById('wmText').value;
      const wmOpacity = parseFloat(document.getElementById('wmOpacity').value) / 100;
      const wmSize = parseInt(document.getElementById('wmSize').value) || 36;
      const wmPosition = getActivePillVal('wmPosGrid') || 'bottom-right';

      const profile = {
        name: 'Creator',
        content_type: contentType,
        audience_age: audienceAge,
        style: style,
        clip_style: clipStyle,
        avoid: avoid,
        language: 'auto',
        example_hooks: currentProfile.example_hooks || ["You won't believe what happened next...", "This is insane...", "Wait for it..."],
        watermark: {
          enabled: wmEnabled,
          text: wmText,
          image_path: currentProfile.watermark?.image_path || '',
          position: wmPosition,
          opacity: wmOpacity,
          size: wmSize
        }
      };

      const imageFileInp = document.getElementById('wmImageFile');
      if (wmEnabled && wmType === 'image' && imageFileInp && imageFileInp.files[0]) {
        const fd = new FormData();
        fd.append('watermark', imageFileInp.files[0]);
        try {
          const res = await fetch('/api/profile/watermark-image', { method: 'POST', body: fd });
          const data = await res.json();
          if (data.success && data.path) {
            profile.watermark.image_path = data.path;
          }
        } catch (err) {
          console.error('Failed to upload watermark image:', err);
          toast('Failed to upload watermark image');
          return;
        }
      }

      try {
        const res = await fetch('/api/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(profile)
        });
        const data = await res.json();
        if (data.success) {
          toast('Profile saved successfully');
          toggleProfilePanel();
        } else {
          toast('Failed to save profile');
        }
      } catch (err) {
        console.error('Failed to save profile:', err);
        toast('Error saving profile');
      }
    }

    function getActivePillVal(rowId) {
      const row = document.getElementById(rowId);
      if (!row) return '';
      const activeBtn = row.querySelector('button.active');
      if (!activeBtn) return '';
      const onclick = activeBtn.getAttribute('onclick');
      const m = onclick.match(/'([^']+)'/g);
      if (m && m.length >= 2) {
        return m[1].replace(/'/g, '');
      }
      return '';
    }
  </script>
</body>

</html>
