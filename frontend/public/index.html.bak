<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQABNjN9GQAAAABJRElEQkSuQmCC" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>Atlantic AI — Forge Viral Clips</title>
  <meta name="description"
    content="Extract viral moments from your streams with AI. Atlantic AI detects, transcribes, reframes, and publishes — so you just play.">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="styles.css?v=3">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    :root {
      --bg: #0A0A0A;
      --bg2: #111111;
      --surf: rgba(255, 255, 255, .04);
      --surfh: rgba(255, 255, 255, .07);
      --bdr: rgba(255, 255, 255, .08);
      --bdra: rgba(168, 216, 160, .5);
      --pri: #A8D8A0;
      --pril: #C5E5BE;
      --cyan: #8DBCA5;
      --rose: #E68A8A;
      --pri-rgb: 168, 216, 160;
      --fg: #ECECEC;
      --fgm: #8A8F98;
      --ease: cubic-bezier(.16, 1, .3, 1);
      --fd: 'JetBrains Mono', monospace;
      --fb: 'Space Grotesk', sans-serif;
      --fm: 'JetBrains Mono', monospace;
    }

    html {
      scroll-behavior: smooth
    }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--fb);
      min-height: 100vh;
      overflow-x: hidden
    }

    .lang-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 8px;
      max-height: 140px;
      overflow-y: auto;
      padding-right: 8px;
    }

    .lang-grid::-webkit-scrollbar {
      width: 4px;
    }

    .lang-grid::-webkit-scrollbar-thumb {
      background: var(--bdr);
      border-radius: 4px;
    }

    .lang-btn {
      padding: 10px;
      border-radius: 10px;
      border: 1px solid var(--bdr);
      background: var(--surf);
      color: var(--fgm);
      font-family: var(--fb);
      font-size: 13px;
      cursor: pointer;
      transition: all .2s;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .lang-btn:hover {
      background: var(--surfh);
      color: var(--fg);
      border-color: rgba(var(--pri-rgb), .3);
    }

    .lang-btn.active {
      border: 1px solid rgba(var(--pri-rgb), .5);
      background: rgba(var(--pri-rgb), .15);
      color: var(--fg);
      font-weight: 600;
    }

    .lang-native {
      font-size: 10px;
      opacity: 0.6;
      font-family: sans-serif;
    }

    .clip-cnt-btn {
      padding: 8px 14px;
      border-radius: 10px;
      border: 1px solid var(--bdr);
      background: var(--surf);
      color: var(--fgm);
      font-family: var(--fb);
      font-size: 13px;
      cursor: pointer;
      transition: all .2s;
    }

    .clip-cnt-btn:hover {
      background: var(--surfh);
      color: var(--fg);
      border-color: rgba(var(--pri-rgb), .3);
    }

    .clip-cnt-btn.active {
      border: 1px solid rgba(var(--pri-rgb), .5);
      background: rgba(var(--pri-rgb), .15);
      color: var(--fg);
      font-weight: 600;
    }

    /* AURORA */
    .aurora {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden
    }

    .ab {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px)
    }

    .ab1 {
      width: 650px;
      height: 650px;
      background: radial-gradient(circle, rgba(185, 255, 102, .2), transparent 70%);
      top: -120px;
      left: -120px;
      animation: bf1 28s ease-in-out infinite
    }

    .ab2 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(143, 232, 61, .14), transparent 70%);
      top: 25%;
      right: -80px;
      animation: bf2 32s ease-in-out infinite
    }

    .ab3 {
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(244, 63, 94, .11), transparent 70%);
      bottom: 10%;
      left: 35%;
      animation: bf3 22s ease-in-out infinite
    }

    @keyframes bf1 {

      0%,
      100% {
        transform: translate(0, 0) scale(1)
      }

      33% {
        transform: translate(90px, 70px) scale(1.12)
      }

      66% {
        transform: translate(-50px, 90px) scale(.95)
      }
    }

    @keyframes bf2 {

      0%,
      100% {
        transform: translate(0, 0) scale(1)
      }

      33% {
        transform: translate(-70px, 50px) scale(1.06)
      }

      66% {
        transform: translate(50px, -70px) scale(.9)
      }
    }

    @keyframes bf3 {

      0%,
      100% {
        transform: translate(0, 0) scale(1)
      }

      50% {
        transform: translate(70px, -50px) scale(1.18)
      }
    }

    /* STARS */
    .stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0
    }

    .star {
      position: absolute;
      border-radius: 50%;
      background: #fff;
      animation: twinkle var(--dur, 3s) ease-in-out var(--delay, 0s) infinite
    }

    @keyframes twinkle {

      0%,
      100% {
        opacity: var(--lo, .08);
        transform: scale(1)
      }

      50% {
        opacity: var(--hi, .55);
        transform: scale(1.4)
      }
    }

    /* PAGE */
    .pg {
      position: relative;
      z-index: 1
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 18px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(9, 9, 15, .75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--bdr)
    }

    .nl {
      font-family: var(--fd);
      font-size: 18px;
      background: linear-gradient(135deg, #fff 0%, #D4FFA8 50%, #B9FF66 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text
    }

    .np {
      font-family: var(--fm);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--fgm);
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 999px;
      padding: 6px 14px;
      display: flex;
      align-items: center;
      gap: 6px
    }

    .ndot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--rose);
      animation: pulse 1.5s ease-in-out infinite
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        box-shadow: 0 0 4px var(--rose)
      }

      50% {
        opacity: .3;
        box-shadow: none
      }
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 120px 24px 80px;
      text-align: center;
      position: relative;
      overflow: hidden
    }

    .hey {
      font-family: var(--fm);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--pril);
      margin-bottom: 28px;
      opacity: 0;
      animation: fu .8s var(--ease) .1s forwards
    }

    .logo-wrapper {
      position: relative;
      display: inline-block;
      margin-bottom: 28px
    }

    .hero-forge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 110%;
      height: auto;
      filter: drop-shadow(0 0 50px rgba(185, 255, 102, .15));
      opacity: 0.1;
      pointer-events: none;
      z-index: 1
    }

    .hlogo {
      font-family: var(--fd);
      font-size: clamp(56px, 11vw, 130px);
      line-height: 1;
      letter-spacing: -2px;
      background: linear-gradient(135deg, #fff 0%, #D4FFA8 25%, #B9FF66 55%, #8FE83D 100%);
      background-size: 300% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0;
      animation: fu .8s var(--ease) .2s forwards, gshimmer 5s linear 1s infinite;
      position: relative;
      z-index: 2
    }

    @keyframes gshimmer {
      0% {
        background-position: 0% center
      }

      100% {
        background-position: 300% center
      }
    }

    .htag {
      font-size: clamp(15px, 2.5vw, 21px);
      color: var(--fgm);
      margin-bottom: 52px;
      max-width: 480px;
      line-height: 1.6;
      font-weight: 300;
      opacity: 0;
      animation: fu .8s var(--ease) .3s forwards
    }

    .htag b {
      color: var(--fg);
      font-weight: 700
    }

    /* FORM */
    .fw {
      width: 100%;
      max-width: 660px;
      opacity: 0;
      animation: fu .8s var(--ease) .45s forwards
    }

    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 12px
    }

    .tab {
      flex: 1;
      padding: 12px 20px;
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 12px;
      color: var(--fgm);
      font-family: var(--fb);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all .2s var(--ease)
    }

    .tab.on {
      background: rgba(185, 255, 102, .15);
      border-color: rgba(185, 255, 102, .5);
      color: var(--fg)
    }

    .tab:hover:not(.on) {
      background: var(--surfh);
      color: var(--fg)
    }

    .urlinp {
      width: 100%;
      padding: 18px 20px;
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 14px;
      color: var(--fg);
      font-family: var(--fb);
      font-size: 15px;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
      margin-bottom: 12px
    }

    .urlinp::placeholder {
      color: var(--fgm)
    }

    .urlinp:focus {
      border-color: var(--pri);
      box-shadow: 0 0 0 3px rgba(185, 255, 102, .15), 0 0 24px rgba(185, 255, 102, .1)
    }

    .fzone {
      display: none;
      align-items: center;
      gap: 12px;
      padding: 18px 20px;
      background: var(--surf);
      border: 1px dashed rgba(255, 255, 255, .14);
      border-radius: 14px;
      cursor: pointer;
      transition: all .2s;
      margin-bottom: 12px
    }

    .fzone:hover {
      background: var(--surfh);
      border-color: var(--pri)
    }

    .fzone.show {
      display: flex
    }

    .flbl {
      color: var(--fgm);
      font-size: 14px;
      cursor: pointer
    }

    /* BUTTON */
    .fbtn {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #B9FF66, #7FBF3D);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: var(--fd);
      font-size: 18px;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform .2s var(--ease), box-shadow .2s
    }

    .fbtn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .18), transparent);
      transition: left .5s var(--ease)
    }

    .fbtn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 36px rgba(185, 255, 102, .45)
    }

    .fbtn:hover::before {
      left: 100%
    }

    .fbtn:active {
      transform: scale(.98)
    }

    .fbtn.ld {
      pointer-events: none;
      background: linear-gradient(135deg, #7FBF3D, #5C9930)
    }

    .bnt {
      display: inline
    }

    .bnl {
      display: none;
      align-items: center;
      gap: 8px;
      justify-content: center;
      font-family: var(--fm);
      font-size: 14px;
      letter-spacing: 2px
    }

    .fbtn.ld .bnt {
      display: none
    }

    .fbtn.ld .bnl {
      display: inline-flex
    }

    .fspin {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, .3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite
    }

    @keyframes spin {
      to {
        transform: rotate(360deg)
      }
    }

    /* STATS */
    .sstrip {
      display: flex;
      gap: 28px;
      justify-content: center;
      margin-top: 32px;
      flex-wrap: wrap;
      opacity: 0;
      animation: fu .8s var(--ease) .6s forwards
    }

    .si {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--fm);
      font-size: 12px;
      color: var(--fgm)
    }

    .sd {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--pril);
      animation: pulse 2s ease-in-out infinite
    }

    .sd.cy {
      background: var(--cyan);
      animation-delay: .3s
    }

    .sd.ro {
      background: var(--rose);
      animation-delay: .6s
    }

    /* FORGE OVERLAY */
    .forge-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(9, 9, 15, .96);
      backdrop-filter: blur(8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .5s var(--ease)
    }

    .forge-overlay.active {
      opacity: 1;
      pointer-events: all
    }

    .forge-scene {
      width: 320px;
      height: 260px;
      margin-bottom: 32px
    }

    .forge-status {
      font-family: var(--fm);
      font-size: 13px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--pril);
      text-align: center;
      animation: flicker 1.5s ease-in-out infinite
    }

    @keyframes flicker {

      0%,
      100% {
        opacity: 1
      }

      45% {
        opacity: .5
      }

      55% {
        opacity: 1
      }

      70% {
        opacity: .65
      }
    }

    .forge-sub {
      font-family: var(--fb);
      font-size: 14px;
      color: var(--fgm);
      text-align: center;
      margin-top: 8px
    }

    .forge-pct {
      font-family: var(--fd);
      font-size: 48px;
      color: #fff;
      margin-top: 16px;
      letter-spacing: -1px
    }

    /* SVG FORGE */
    #hg {
      transform-origin: 235px 128px;
      animation: hstrike 1s ease-in-out infinite
    }

    @keyframes hstrike {

      0%,
      60% {
        transform: rotate(-50deg)
      }

      78% {
        transform: rotate(14deg)
      }

      88% {
        transform: rotate(14deg)
      }

      100% {
        transform: rotate(-50deg)
      }
    }

    .fire-anim {
      animation: fireanim 1s ease-in-out infinite
    }

    @keyframes fireanim {

      0%,
      100% {
        opacity: .55;
        transform: scaleY(1)
      }

      50% {
        opacity: .9;
        transform: scaleY(1.15)
      }
    }

    .fire-inner {
      animation: fireanim .7s ease-in-out infinite
    }

    .glow-anim {
      animation: glowpulse 1s ease-in-out infinite
    }

    @keyframes glowpulse {

      0%,
      60%,
      100% {
        opacity: 0
      }

      78%,
      88% {
        opacity: .85
      }
    }

    .sp {
      opacity: 0;
      animation: 1s ease-out infinite
    }

    .sp1 {
      animation-name: sp1k;
      fill: #D4FFA8
    }

    .sp2 {
      animation-name: sp2k;
      fill: #8FE83D
    }

    .sp3 {
      animation-name: sp3k;
      fill: #D4FFA8
    }

    .sp4 {
      animation-name: sp4k;
      fill: #fff
    }

    .sp5 {
      animation-name: sp5k;
      fill: #8FE83D
    }

    .sp6 {
      animation-name: sp6k;
      fill: #D4FFA8
    }

    .sp7 {
      animation-name: sp7k;
      fill: #fff
    }

    .sp8 {
      animation-name: sp8k;
      fill: #B9FF66
    }

    @keyframes sp1k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: 1
      }

      100% {
        opacity: 0;
        transform: translate(-18px, -38px)
      }
    }

    @keyframes sp2k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: 1
      }

      100% {
        opacity: 0;
        transform: translate(12px, -42px)
      }
    }

    @keyframes sp3k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: .8
      }

      100% {
        opacity: 0;
        transform: translate(-8px, -50px)
      }
    }

    @keyframes sp4k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: 1
      }

      100% {
        opacity: 0;
        transform: translate(22px, -30px)
      }
    }

    @keyframes sp5k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: .6
      }

      100% {
        opacity: 0;
        transform: translate(-28px, -22px)
      }
    }

    @keyframes sp6k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: 1
      }

      100% {
        opacity: 0;
        transform: translate(6px, -44px)
      }
    }

    @keyframes sp7k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: .8
      }

      100% {
        opacity: 0;
        transform: translate(-14px, -32px)
      }
    }

    @keyframes sp8k {

      0%,
      76% {
        opacity: 0;
        transform: translate(0, 0)
      }

      78% {
        opacity: 1
      }

      100% {
        opacity: 0;
        transform: translate(30px, -24px)
      }
    }

    /* SECTIONS */
    section {
      padding: 100px 24px
    }

    .siw {
      max-width: 1200px;
      margin: 0 auto
    }

    .ey {
      font-family: var(--fm);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--pri);
      margin-bottom: 12px;
      display: block
    }

    .sh {
      font-family: var(--fd);
      font-size: clamp(28px, 4vw, 46px);
      line-height: 1.1;
      color: var(--fg);
      margin-bottom: 16px
    }

    .ss {
      font-size: 16px;
      color: var(--fgm);
      max-width: 520px;
      line-height: 1.7;
      font-weight: 300
    }

    /* REVEAL */
    .rv {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .7s var(--ease), transform .7s var(--ease)
    }

    .rv.in {
      opacity: 1;
      transform: translateY(0)
    }

    .d1 {
      transition-delay: .1s
    }

    .d2 {
      transition-delay: .2s
    }

    .d3 {
      transition-delay: .3s
    }

    /* BENTO */
    .bh {
      text-align: center;
      margin-bottom: 56px
    }

    .bh .ss {
      margin: 0 auto
    }

    .bgrid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 200px;
      gap: 14px
    }

    .bc {
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 20px;
      padding: 28px;
      overflow: hidden;
      position: relative;
      transition: transform .3s var(--ease), border-color .3s, box-shadow .3s
    }

    .bc:hover {
      transform: translateY(-4px) scale(1.01);
      border-color: rgba(185, 255, 102, .4);
      box-shadow: 0 20px 50px rgba(0, 0, 0, .3), 0 0 0 1px rgba(185, 255, 102, .15)
    }

    .bca {
      grid-column: 1/3;
      grid-row: 1/3
    }

    .bcb {
      grid-column: 3/5;
      grid-row: 1/2
    }

    .bcc {
      grid-column: 3/4;
      grid-row: 2/3
    }

    .bcd {
      grid-column: 4/5;
      grid-row: 2/4
    }

    .bce {
      grid-column: 1/4;
      grid-row: 3/4
    }

    .bdg {
      display: inline-block;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-family: var(--fm);
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 14px
    }

    .bv {
      color: var(--pril);
      background: rgba(185, 255, 102, .15)
    }

    .bc2 {
      color: #C7FF8F;
      background: rgba(143, 232, 61, .15)
    }

    /* Counter */
    .cnum {
      font-family: var(--fd);
      font-size: 80px;
      line-height: 1;
      background: linear-gradient(135deg, #fff, #D4FFA8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 8px 0 4px
    }

    .clbl {
      font-size: 14px;
      color: var(--fgm);
      margin-bottom: 20px;
      font-weight: 300
    }

    .ctrk {
      width: 100%;
      height: 3px;
      background: rgba(255, 255, 255, .06);
      border-radius: 99px;
      overflow: hidden
    }

    .cfil {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--pri), var(--pril));
      border-radius: 99px;
      transition: width 1.8s cubic-bezier(.16, 1, .3, 1)
    }

    .ctrd {
      font-family: var(--fm);
      font-size: 11px;
      color: var(--pril);
      margin-top: 8px;
      text-align: right
    }

    .cbl1 {
      position: absolute;
      width: 150px;
      height: 150px;
      background: var(--pri);
      opacity: .1;
      border-radius: 50%;
      filter: blur(55px);
      top: -30px;
      right: -30px;
      pointer-events: none
    }

    .cbl2 {
      position: absolute;
      width: 100px;
      height: 100px;
      background: var(--rose);
      opacity: .07;
      border-radius: 50%;
      filter: blur(35px);
      bottom: 10px;
      left: 10px;
      pointer-events: none
    }

    /* Waveform */
    .wr {
      display: flex;
      height: 100%
    }

    .wl {
      width: 42%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-right: 16px
    }

    .wtt {
      font-family: var(--fd);
      font-size: 16px;
      color: var(--fg);
      margin: 6px 0 4px;
      line-height: 1.3
    }

    .wsb {
      font-size: 12px;
      color: var(--fgm);
      line-height: 1.5;
      font-weight: 300
    }

    .wbs {
      display: flex;
      align-items: center;
      gap: 3px;
      width: 58%;
      padding: 16px 0 16px 8px
    }

    .wb {
      width: 4px;
      border-radius: 2px;
      background: var(--pri);
      animation: wa 1.2s ease-in-out infinite
    }

    .wb.a {
      background: var(--pril)
    }

    @keyframes wa {

      0%,
      100% {
        opacity: 1;
        transform: scaleY(1)
      }

      50% {
        opacity: .4;
        transform: scaleY(.45)
      }
    }

    /* Platforms */
    .plbl {
      font-family: var(--fm);
      font-size: 10px;
      color: var(--fgm);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px
    }

    .prow {
      display: flex;
      gap: 10px
    }

    .pt {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      border: 1px solid var(--bdr);
      background: var(--surf);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      transition: all .2s;
      color: var(--fg)
    }

    .pt:hover {
      transform: scale(1.1)
    }

    .pt.yt:hover {
      border-color: #FF0000;
      box-shadow: 0 0 14px rgba(255, 0, 0, .3)
    }

    .pt.tt:hover {
      border-color: #fff;
      box-shadow: 0 0 14px rgba(255, 255, 255, .2)
    }

    .pt.ig:hover {
      border-color: #E1306C;
      box-shadow: 0 0 14px rgba(225, 48, 108, .3)
    }

    .pt.xx:hover {
      border-color: var(--pril);
      box-shadow: 0 0 14px rgba(212, 255, 168, .3)
    }

    .ptg {
      font-size: 13px;
      font-weight: 600;
      color: var(--fg);
      margin-top: 14px
    }

    /* Phone */
    .phw {
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 100%;
      justify-content: center
    }

    .phs {
      width: 100px;
      height: 182px;
      border-radius: 18px;
      border: 2px solid rgba(212, 255, 168, .35);
      background: #0d0d18;
      margin: 12px auto;
      overflow: hidden;
      display: flex
    }

    .phl {
      width: 50%;
      background: rgba(185, 255, 102, .1);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-right: 1px solid var(--bdr);
      gap: 6px
    }

    .phr {
      width: 50%;
      background: rgba(143, 232, 61, .08);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px
    }

    .phrl {
      font-size: 8px;
      color: var(--fgm);
      font-family: var(--fm)
    }

    .phrh {
      width: 36px;
      height: 20px;
      border-radius: 4px;
      background: rgba(185, 255, 102, .55)
    }

    .phrv {
      width: 20px;
      height: 34px;
      border-radius: 4px;
      background: rgba(143, 232, 61, .65)
    }

    .phtg {
      font-size: 11px;
      color: var(--fgm);
      text-align: center;
      margin-top: 4px;
      font-weight: 300
    }

    /* Recap */
    .rrow {
      display: flex;
      align-items: center;
      height: 100%;
      gap: 20px
    }

    .rl {
      flex: 0 0 auto;
      max-width: 290px
    }

    .rtl {
      font-family: var(--fd);
      font-size: 18px;
      color: var(--fg);
      margin: 6px 0 4px
    }

    .rsb {
      font-size: 12px;
      color: var(--fgm);
      line-height: 1.6;
      font-weight: 300
    }

    .rsts {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-left: auto;
      flex-shrink: 0
    }

    .rdv {
      width: 1px;
      height: 40px;
      background: var(--bdr)
    }

    .rst {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px
    }

    .rsn {
      font-family: var(--fd);
      font-size: 24px;
      line-height: 1
    }

    .rsl {
      font-family: var(--fm);
      font-size: 10px;
      color: var(--fgm);
      text-align: center
    }

    /* BENTO RESPONSIVE */
    @media(max-width:1024px) {
      .bgrid {
        grid-template-columns: repeat(2, 1fr)
      }

      .bca,
      .bcb,
      .bcc,
      .bcd,
      .bce {
        grid-column: auto;
        grid-row: auto
      }

      .bca {
        grid-column: span 2;
        grid-row: span 2
      }
    }

    @media(max-width:640px) {
      .bgrid {
        grid-template-columns: 1fr;
        grid-auto-rows: auto
      }

      .bca {
        grid-column: auto;
        grid-row: auto;
        min-height: 220px
      }

      .cnum {
        font-size: 54px
      }

      .rrow {
        flex-direction: column;
        align-items: flex-start
      }

      .rsts {
        margin-left: 0;
        flex-wrap: wrap
      }
    }

    /* KILL FEED */
    .kfs {
      padding: 56px 0;
      overflow: hidden;
      border-top: 1px solid var(--bdr);
      border-bottom: 1px solid var(--bdr)
    }

    .kfl {
      text-align: center;
      font-family: var(--fm);
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--fgm);
      margin-bottom: 20px
    }

    .kft {
      display: flex;
      width: max-content;
      animation: ks 42s linear infinite
    }

    .kft:hover {
      animation-play-state: paused
    }

    .kfi {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 22px;
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 8px;
      margin-right: 12px;
      flex-shrink: 0;
      font-family: var(--fm);
      font-size: 12px;
      white-space: nowrap
    }

    .kfn {
      color: var(--pril);
      font-weight: 500
    }

    .kfa {
      color: var(--fgm)
    }

    .kfv {
      color: var(--fg)
    }

    .kfd {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--fgm)
    }

    @keyframes ks {
      0% {
        transform: translateX(0)
      }

      100% {
        transform: translateX(-50%)
      }
    }

    /* HOW IT WORKS */
    .sgrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 56px
    }

    .sc {
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 20px;
      padding: 36px 28px;
      transition: all .3s var(--ease);
      position: relative;
      overflow: hidden
    }

    .sc::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(185, 255, 102, .06), transparent);
      opacity: 0;
      transition: opacity .3s
    }

    .sc:hover {
      border-color: rgba(185, 255, 102, .35);
      transform: translateY(-4px)
    }

    .sc:hover::before {
      opacity: 1
    }

    .sico {
      font-size: 28px;
      margin-bottom: 20px;
      display: block
    }

    .snum {
      font-family: var(--fd);
      font-size: 46px;
      line-height: 1;
      background: linear-gradient(135deg, rgba(185, 255, 102, .5), rgba(185, 255, 102, .12));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 16px
    }

    .stl {
      font-family: var(--fd);
      font-size: 18px;
      color: var(--fg);
      margin-bottom: 10px
    }

    .sds {
      font-size: 14px;
      color: var(--fgm);
      line-height: 1.7;
      font-weight: 300
    }

    @media(max-width:768px) {
      .sgrid {
        grid-template-columns: 1fr
      }
    }

    /* RECENT */
    .recsec {
      padding: 80px 24px
    }

    .rechd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px
    }

    .rectl {
      font-family: var(--fd);
      font-size: 20px;
      color: var(--fg)
    }

    .recemp {
      text-align: center;
      padding: 60px 24px;
      background: var(--surf);
      border: 1px dashed var(--bdr);
      border-radius: 20px;
      color: var(--fgm);
      font-size: 14px;
      line-height: 1.9
    }

    .recei {
      font-size: 36px;
      margin-bottom: 12px
    }

    /* Job card (loaded by app.js) */
    .job-card {
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 8px;
      font-size: 14px;
      cursor: pointer;
      transition: border-color .2s
    }

    .job-card:hover {
      border-color: rgba(185, 255, 102, .4)
    }

    .job-card strong {
      color: var(--fg);
      font-weight: 600
    }

    /* BOTTOM CTA */
    .bcta {
      padding: 100px 24px;
      text-align: center;
      border-top: 1px solid var(--bdr)
    }

    .bctah {
      font-family: var(--fd);
      font-size: clamp(30px, 4.5vw, 54px);
      color: var(--fg);
      line-height: 1.1;
      margin-bottom: 16px
    }

    .bctas {
      font-size: 16px;
      color: var(--fgm);
      margin-bottom: 44px;
      font-weight: 300
    }

    .bctabtn {
      display: inline-block;
      padding: 18px 52px;
      background: linear-gradient(135deg, var(--pri), #7FBF3D);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: var(--fd);
      font-size: 18px;
      cursor: pointer;
      transition: all .3s var(--ease);
      position: relative;
      overflow: hidden
    }

    .bctabtn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .16), transparent);
      transition: left .5s var(--ease)
    }

    .bctabtn:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 44px rgba(185, 255, 102, .4)
    }

    .bctabtn:hover::before {
      left: 100%
    }

    /* FOOTER */
    footer {
      padding: 36px 40px;
      border-top: 1px solid var(--bdr);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px
    }

    .fl {
      font-family: var(--fd);
      font-size: 16px;
      background: linear-gradient(135deg, #D4FFA8, #B9FF66);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text
    }

    .fn {
      font-family: var(--fm);
      font-size: 11px;
      color: var(--fgm)
    }

    /* ╒╒╒╒╒╒╒ RESULTS SECTION ╒╒╒╒╒╒╒ */
    .cf-results {
      display: none;
      padding: 100px 24px
    }

    .cf-results.active {
      display: block
    }

    .cf-results-inner {
      max-width: 1000px;
      margin: 0 auto
    }

    .cf-results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px
    }

    .cf-results-title {
      font-family: var(--fd);
      font-size: 28px;
      color: var(--fg)
    }

    .cf-results-back {
      padding: 10px 24px;
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 12px;
      color: var(--fg);
      font-family: var(--fb);
      font-size: 14px;
      cursor: pointer;
      transition: all .2s
    }

    .cf-results-back:hover {
      border-color: rgba(185, 255, 102, .4);
      background: var(--surfh)
    }

    .cf-clips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px
    }

    .cf-clip-card {
      background: var(--surf);
      border: 1px solid var(--bdr);
      border-radius: 16px;
      padding: 20px;
      overflow: hidden;
      transition: border-color .3s
    }

    .cf-clip-card:hover {
      border-color: rgba(185, 255, 102, .4)
    }

    .cf-clip-card video {
      width: 100%;
      border-radius: 10px;
      margin-bottom: 12px
    }

    .cf-clip-card h3 {
      font-family: var(--fd);
      font-size: 16px;
      color: var(--fg);
      margin-bottom: 4px
    }

    .cf-clip-card .cf-score {
      font-family: var(--fm);
      font-size: 12px;
      color: var(--fgm);
      margin-bottom: 12px
    }

    .cf-clip-actions {
      display: flex;
      gap: 8px
    }

    .cf-clip-actions .btn,
    .cf-clip-actions a.btn {
      flex: 1;
      padding: 10px;
      text-align: center;
      font-family: var(--fb);
      font-size: 13px;
      font-weight: 600;
      border-radius: 10px;
      cursor: pointer;
      text-decoration: none;
      transition: all .2s
    }

    .cf-clip-actions .btn-pri {
      background: var(--pri);
      color: #fff;
      border: none
    }

    .cf-clip-actions .btn-pri:hover {
      background: #7FBF3D
    }

    .cf-clip-actions .btn-out {
      background: none;
      color: var(--fg);
      border: 1px solid var(--bdr)
    }

    .cf-clip-actions .btn-out:hover {
      border-color: rgba(185, 255, 102, .4)
    }

    /* TOAST */
    .toast {
      position: fixed;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: rgba(30, 28, 53, .95);
      color: var(--fg);
      border: 1px solid var(--bdr);
      padding: 14px 28px;
      border-radius: 14px;
      font-family: var(--fb);
      font-size: 14px;
      z-index: 300;
      backdrop-filter: blur(12px);
      transition: transform .4s var(--ease), opacity .4s;
      opacity: 0;
      pointer-events: none
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      pointer-events: all
    }

    /* HERO FORGE */
    .hero-forge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 110%;
      height: auto;
      filter: drop-shadow(0 0 50px rgba(185, 255, 102, .25));
      animation: forgeFloat 6s ease-in-out infinite;
      z-index: 1;
      pointer-events: none
    }

    @keyframes forgeFloat {

      0%,
      100% {
        transform: translate(-50%, -50%)
      }

      50% {
        transform: translate(-50%, calc(-50% - 12px))
      }
    }

    @keyframes fu {
      from {
        opacity: 0;
        transform: translateY(20px)
      }

      to {
        opacity: 1;
        transform: translateY(0)
      }
    }

    @media(prefers-reduced-motion:reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important
      }
    }

    @media(max-width:600px) {
      nav {
        padding: 16px 20px
      }

      section {
        padding: 72px 20px
      }
    }

    /* ── Creator Profile Panel ── */
    .profile-overlay {
      position: fixed;
      inset: 0;
      z-index: 9980;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s var(--ease)
    }

    .profile-overlay.open {
      opacity: 1;
      pointer-events: auto
    }

    .profile-panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 380px;
      max-width: 90vw;
      z-index: 9985;
      padding: 1.5rem;
      overflow-y: auto;
      transform: translateX(100%);
      background: rgba(13, 13, 22, 0.95);
      backdrop-filter: blur(16px);
      border-left: 1px solid var(--bdr);
      transition: transform 0.4s var(--ease);
    }

    .profile-panel.open {
      transform: translateX(0)
    }

    .pp-section {
      margin-bottom: 1rem
    }

    .pill-label {
      font-family: var(--fm);
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--fgm);
      margin-bottom: 8px
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px
    }

    .clip-pill {
      padding: 6px 12px;
      border: 1px solid var(--bdr);
      background: var(--surf);
      color: var(--fgm);
      font-family: var(--fb);
      font-size: 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .clip-pill.active {
      background: rgba(185, 255, 102, 0.15);
      border-color: var(--pri);
      color: var(--fg)
    }

    .clip-pill:hover:not(.active) {
      background: var(--surfh);
      color: var(--fg)
    }

    .pp-textarea {
      width: 100%;
      border: 1px solid var(--bdr);
      border-radius: 8px;
      background: var(--surf);
      color: var(--fg);
      font-family: var(--fb);
      font-size: 13px;
      padding: 10px 12px;
      outline: none;
      resize: vertical;
    }

    .pp-textarea:focus {
      border-color: rgba(185, 255, 102, 0.4)
    }

    .toggle-switch {
      position: relative;
      width: 44px;
      height: 24px;
      display: inline-block
    }

    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0
    }

    .toggle-slider {
      position: absolute;
      inset: 0;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.1);
      cursor: pointer;
      transition: background 0.3s;
    }

    .toggle-slider::after {
      content: '';
      position: absolute;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      top: 3px;
      left: 3px;
      transition: transform 0.3s
    }

    .toggle-switch input:checked+.toggle-slider {
      background: var(--pri)
    }

    .toggle-switch input:checked+.toggle-slider::after {
      transform: translateX(20px)
    }

    .wm-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      width: 120px;
    }

    .wm-grid button {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--bdr);
      background: var(--surf);
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.6rem;
      color: var(--fgm);
    }

    .wm-grid button.active {
      border-color: var(--pri);
      background: rgba(185, 255, 102, 0.15);
      color: var(--fg)
    }

    .wm-grid button:hover {
      background: var(--surfh)
    }

    .pp-range {
      width: 100%;
      -webkit-appearance: none;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.1);
      outline: none;
    }

    .pp-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--pri);
      cursor: pointer
    }
  </style>
</head>

<body>

  <div class="aurora" aria-hidden="true">
    <div class="ab ab1"></div>
    <div class="ab ab2"></div>
    <div class="ab ab3"></div>
  </div>
  <div class="stars" id="stars" aria-hidden="true"></div>

  <!-- FORGE OVERLAY (processing animation) -->
  <div class="forge-overlay" id="forgeOverlay">
    <svg class="forge-scene" viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="fg1" cx="50%" cy="20%">
