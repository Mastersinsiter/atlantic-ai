# Atlantic AI backend — Vercel container
# Vercel builds Dockerfile.vercel automatically and runs the HTTP server on $PORT.
FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1

# System dependencies used by Atlantic AI:
# - ffmpeg: video/audio processing
# - python3/pip: aligner.py and Python-side tooling
# - yt-dlp: YouTube source downloads
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg \
       python3 \
       python3-pip \
       ca-certificates \
       curl \
    && python3 -m pip install --no-cache-dir --break-system-packages yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install backend Node dependencies first for better Docker layer caching.
COPY backend/package*.json ./backend/
RUN npm ci --prefix backend --omit=dev

# The Express server serves frontend/public itself, so both folders are included.
COPY backend ./backend
COPY frontend ./frontend

# The application already uses process.env.PORT, which Vercel provides.
EXPOSE 3000

CMD ["node", "backend/src/server.js"]
