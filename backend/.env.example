# Required — Gemini (clip analysis + transcription fallback)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for best captions — OpenAI Whisper API (word-level timestamps)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — server port (defaults to 3000 if not set)
PORT=3000

# Optional — only needed if you've enabled YouTube upload/OAuth features
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
